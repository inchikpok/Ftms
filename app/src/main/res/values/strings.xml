    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">v2.2 — BLE treadmill control (FTMS)</string>
    <string name="about_description">Universal app for treadmills supporting the FTMS standard (Fitness Machine Service, Bluetooth SIG). Works fully offline. INTERNET permission is intentionally not requested.</string>
    <string name="about_compat_title">Compatibility</string>
    <string name="about_compat_items">• Protocol: FTMS (Bluetooth SIG standard)\n• Any treadmill with FTMS support\n• e.g. FitShow, Horizon, Bowflex, Sole, NordicTrack\n• Heart rate monitors: HR Service (0x180D)\n• Treadmill capabilities (speed, incline) are detected automatically</string>
    <string name="about_features_title">Features</string>
    <string name="about_features_items">• Auto-detection of treadmill features via FTMS Feature\n• BLE connection with auto-reconnect\n• Chest strap HR + zone chart\n• Auto speed regulation by heart rate\n• Training programs (manual and auto)\n• Workout generator by profile (weight, age, level)\n• Heart rate zones via Karvonen formula\n• Voice prompts with customizable phrases (TTS)\n• Background work (Foreground Service)\n• Workout log (Room)\n• Debug screen with full BLE log</string>
    <string name="about_stack_title">Stack</string>
    <string name="about_stack_items">• Kotlin 1.9.22 · JVM 17\n• Jetpack Compose · Material 3\n• Room 2.6.1 · kotlinx.serialization\n• minSdk 21 · targetSdk 34 · AGP 8.2.2</string>
    <string name="about_custom_workout_title">Create your own workout</string>
    <string name="about_custom_workout_desc">Copy the template, edit it in any notes app, copy back and paste into "Programs → From file". No need to save any files.</string>
    <string name="about_copy_template">Template</string>
    <string name="about_copy_instructions">Instructions</string>
    <string name="about_template_copied">JSON template copied</string>
    <string name="about_instructions_copied">Instructions copied</string>
    <string name="about_footer">Made for personal use. Works offline.</string>
    <string name="about_instructions">HOW TO CREATE YOUR OWN WORKOUT\n\n1. Tap "Template" — JSON is copied to clipboard\n2. Open any notes app\n3. Paste the template\n4. Edit:\n   - "name" — program name\n   - "description" — optional\n   - "segments" — list of segments\n\n   Segment fields:\n   - "name" — segment name (string)\n   - "durationSec" — duration in SECONDS (300 = 5 min)\n   - "speedKmh" — speed in km/h\n   - "inclinePercent" — incline in %\n\n5. Copy all text from notes\n6. In the app open "Programs" → import from file\n7. Done — the program appears in the list\n\nIMPORTANT:\n- Do not remove quotes and commas\n- Each segment in { }\n- Comma between segments, none after the last\n- Integers are fine: 300 instead of 300.0\n- Speed and incline are limited by your treadmill</string>

